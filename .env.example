# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the real .env file.

# --- Backend: required in production ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-32-plus-character-string

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=replace-with-a-fernet-key

# --- Backend: optional ---
ENV=production
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
MAX_PAGES=200

# LLM provider: mock | gemini | groq (design doc section 4)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Frontend ---
# Baked into the client bundle at build time.
NEXT_PUBLIC_API_BASE=http://localhost:8000
